# 轻单环境变量模板：复制为 .env 后逐项填写真实值。
# .env 已被 .gitignore 忽略，不要提交；等号右边不要写行内注释（dotenv 会把注释当成值的一部分）。

# ---------- 数据库（compose 的 postgres 服务与 api 共用） ----------
# PostgreSQL 用户名（容器首次初始化时创建）
POSTGRES_USER=qingdan

# PostgreSQL 密码（密钥，勿入库）：生产环境必须换成强随机值
POSTGRES_PASSWORD=change-me-strong-password

# PostgreSQL 数据库名（容器首次初始化时创建）
POSTGRES_DB=qingdan

# 应用数据库连接串（密钥，勿入库）：host 必须是 compose 服务名 postgres；
# 密码含特殊字符时要 URL 编码
DATABASE_URL=postgres://qingdan:change-me-strong-password@postgres:5432/qingdan

# ---------- API 运行参数（apps/api/src/platform/config.ts） ----------
# 运行环境：production / development / test
NODE_ENV=production

# API 在容器内监听的端口（默认 3000；compose 健康检查与 Caddy 都按这个端口）
PORT=3000

# API 监听地址：容器内必须是 0.0.0.0，否则 Caddy 访问不到
HOST=0.0.0.0

# 日志级别：fatal / error / warn / info / debug / trace
LOG_LEVEL=info

# 开发态短信/验证码固定值（生产不要依赖它；密钥，勿入库）
LOGIN_DEV_CODE=000000

# 登录会话有效期（天）
SESSION_TTL_DAYS=7

# 业务时区（影响按天聚合的结算口径）
APP_TIMEZONE=Asia/Shanghai

# 对外访问基址：填最终域名（含协议）；本地联调可留 http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:3000

# 是否信任反向代理头（放在 Caddy 后面应设为 true，用于取真实客户端 IP/协议）
TRUST_PROXY=true

# ---------- 支付回调 ----------
# 支付商户配置（单行 JSON，密钥，勿入库）：按 companyId 分渠道填写；
# 空字符串表示该渠道未启用。 JSON 里不要出现换行。
QINGDAN_PAYMENT_CONFIG={"<companyId>":{"wechat":{"mchId":"","apiV3Key":"","platformPublicKeyPem":"","appId":""},"alipay":{"appId":"","alipayPublicKeyPem":"","privateKeyPem":""}}}

# ---------- Caddy ----------
# 站点地址：没有域名时保持 :80（纯 HTTP）；有域名并完成备案后改成 qingdan.example.com，自动申请证书并启用 HTTPS
SITE_ADDRESS=:80

# ---------- MCP / CLI（不在容器里跑时使用，可留空） ----------
# MCP 访问 API 的基址
QINGDAN_BASE_URL=http://127.0.0.1:3000

# MCP 是否允许审批类操作：默认 false，安全起见不要随意开启
QINGDAN_TENANT_ALLOWS_APPROVAL=false

# CLI / MCP 调用 API 的令牌（密钥，勿入库）；仅在客户端侧使用
QINGDAN_TOKEN=

# 集成测试专用数据库连接串（密钥，勿入库）；仅 pnpm test 使用，生产不要填
QINGDAN_TEST_DB=
