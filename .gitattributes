# Git 属性：这条不是可选项
# core.autocrlf=true（本机就是 true）会让 git 在 checkout 时把文本转成 CRLF。
# hook 是 sh 脚本，shebang 后若带 \r，Git Bash / sh 会报
#   "/bin/sh: ./pre-commit: /bin/sh^M: bad interpreter"
# 所以 hook 必须钉死 LF，且不受本机 autocrlf 影响。
# 本文件自己也钉 LF：带 \r 的属性行会让匹配规则失效。
.gitattributes   text eol=lf
tools/pre-commit text eol=lf
*.sh             text eol=lf

# PowerShell 脚本钉 LF（P0-1 测试校验 BOM；行尾统一避免「整文件 diff」与跨平台差异）。
# 注意：BOM 由脚本自身携带，与行尾无关（write/edit 工具会丢 BOM，改完必须补）。
*.ps1            text eol=lf
*.psm1           text eol=lf

# 跨平台主链文本统一 LF（CI 在 ubuntu 跑，文档/源码保持同一份行尾）
*.ts             text eol=lf
*.tsx            text eol=lf
*.json           text eol=lf
*.md             text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.sql            text eol=lf
*.css            text eol=lf
*.html           text eol=lf

# 协议与公开法律文本一律 LF（AGPL 原文是官方逐字副本，行尾不能被本机 autocrlf 改掉）
LICENSE          text eol=lf

# 容器与部署配置一律 LF：Dockerfile / Caddyfile 带 CRLF 会在 Linux 构建时报
# 「unknown instruction」或把 \r 带进指令行；env 文件的 \r 会被当成值的一部分。
Dockerfile       text eol=lf
.dockerignore    text eol=lf
.env.example     text eol=lf
Caddyfile        text eol=lf
